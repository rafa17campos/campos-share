# --- Share service (required) -------------------------------------------------------------
BLOB_READ_WRITE_TOKEN=
SHARE_API_TOKEN=
SHARE_COOKIE_SECRET=
SHARE_BASE_URL=https://share.example.com

# --- MCP server and OAuth authorization server (required for /mcp) -----------------------
# Signs every OAuth artefact (client ids, codes, access and refresh tokens). 32+ characters.
# Rotating it logs every client out.
MCP_OAUTH_SECRET=
# scrypt hash of the login passphrase: `npm run passphrase:hash`
MCP_LOGIN_PASSPHRASE_HASH=

# --- Optional ----------------------------------------------------------------------------
# Bearer token for terminal clients (Gemini CLI, scripts). Off when empty. 32+ characters.
MCP_STATIC_TOKEN=
# Scopes the static token carries. Default: files:read files:write (never delete).
MCP_STATIC_TOKEN_SCOPES=files:read files:write
# Pre-registered OAuth clients, for hosts that take a client id and secret instead of
# registering themselves. JSON array.
# MCP_OAUTH_CLIENTS=[{"client_id":"gemini-manual","client_secret":"...","client_name":"Gemini","redirect_uris":["https://..."]}]
# Browser origins allowed on /mcp. Default `*` (bearer auth carries no ambient authority).
MCP_ALLOWED_ORIGINS=*
# Language stamped on folders the MCP tools create. Default: es.
SHARE_DEFAULT_LANG=es
# `memory` runs the service against in-memory storage, so nothing reaches Vercel Blob.
# Local development and tests only; leave it unset in production.
# STORAGE_PROVIDER=memory
