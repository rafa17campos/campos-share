{
  "name": "campos-share",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Provider-agnostic static share publishing system",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rafa17campos/campos-share.git"
  },
  "homepage": "https://github.com/rafa17campos/campos-share#readme",
  "bugs": "https://github.com/rafa17campos/campos-share/issues",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "passphrase:hash": "node --experimental-strip-types scripts/hash-passphrase.mjs",
    "mcp:inspect": "npx -y @modelcontextprotocol/inspector",
    "mcp:check": "npx -y @modelcontextprotocol/inspector --cli --server-url \"${MCP_URL:-http://localhost:3000/mcp}\" --transport http --header \"Authorization: Bearer $MCP_STATIC_TOKEN\" --method tools/list --strict"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@vercel/blob": "^2.8.0",
    "jose": "^6.2.12",
    "marked": "^18.0.13",
    "next": "^15.5.25",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.3"
  }
}
